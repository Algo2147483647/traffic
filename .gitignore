# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
/.idea/
/.github/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.npm-cache/
/traffic
/traffic.exe
*.tsbuildinfo

# Desktop build outputs
/desktop/node_modules/
/desktop/runtime/
/desktop/dist/
/desktop/dist-updated/
/desktop/dist-junction/
/desktop/dist-junction-focus/
/desktop/dist-phases/

# Geometry compiler cache
/scripts/**/__pycache__/
